# Python
backend/.venv/
__pycache__/
*.pyc

# Secrets — never commit the Etherscan key
backend/.env

# Local database
*.db
# SQLite's write-ahead log and its index, beside every store in WAL mode.
*.db-shm
*.db-wal
# The private label store: its build and download temp files, and any copy of
# it under data/ (scripts/build_label_store.py, scripts/fetch_label_store.py).
*.building
*.partial
backend/data/label_store*
# Rows a store build refused (never_flag.py), listed beside the private hunt CSV.
*.refused.tsv

# Node
frontend/node_modules/
frontend/dist/
citizen/node_modules/
citizen/dist/

# OS
.DS_Store

# Kept on this machine only: session briefs and notes, the TraceChain one-pager,
# and the rejected first cut of the launch film (its music may be a stock track)
_archive/

# Video-tool installs (Hyperframes / brag skill)
.agents/
.claude/*
# ...except the team's shared Claude Code settings (attribution off, ADR-0010)
!.claude/settings.json
skills-lock.json

# Local case-store backups, the demo-case keep list, import checkpoints
backend/*.db.bak-*
backend/keep13.txt
backend/*_check.jsonl

# Playwright run output
frontend/test-results/
frontend/playwright-report/

# Report signing key (made on first start; see backend/app/signing.py)
backend/*.pem

# Anything private, at any depth (r1-secrets-history-2). The narrower lines
# above matched only one folder; these cover case-store files and their
# backups, dumps, keys and env files wherever a script writes them.
**/*.db
**/*.db-*
**/*.db.*
**/*.sqlite*
**/backups/
**/*.db.gz
**/*.pgdump
**/*.age
**/*.pem
**/*.key
**/.env
**/.env.*
!backend/.env.example
**/*keys*.env
**/*_check.jsonl
