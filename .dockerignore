**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.env
**/*.db
# The private label store is fetched inside the build, never copied from here.
**/*.building
**/*.partial
backend/data/label_store*
.git
.DS_Store
*.pdf
**/*.pem
docs
# The same private files as .gitignore, at any depth: a locally built image
# must not carry a case store, a backup, a key or an env file.
**/*.db-*
**/*.db.*
**/*.sqlite*
**/backups
**/*.pgdump
**/*.age
**/*.key
**/.env.*
**/*keys*.env
**/*_check.jsonl
