# No dependency's install hook (preinstall, install, postinstall) runs, here
# or on a laptop: nothing in package-lock.json needs one, and a hook is how a
# hijacked release runs code on install. `npm test`, `npm run build` and the
# other named scripts still run. backend/tests/test_supply_chain.py checks it.
ignore-scripts=true
audit-level=high
