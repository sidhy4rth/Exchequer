# Get a free API key at https://etherscan.io/apis  (Sign in -> API Keys -> Add)
ETHERSCAN_API_KEY=your_key_here

# Free key from https://nodereal.io — serves BNB Smart Chain, which Etherscan's
# free tier does not (it answers "Free API access is not supported for this chain"
# for any chainid other than 1). Leave blank and Ethereum still works; BSC will
# report itself unavailable instead of failing mid-trace.
NODEREAL_API_KEY=

# Free key from https://www.trongrid.io — raises the Tron rate limit.
# Tron works without a key, just slowly: keyless requests are throttled to
# roughly one every 1.2 seconds, and a key drops that to 0.2.
TRONGRID_API_KEY=

# Which chain a request that names none is traced on: ethereum, bsc or tron.
EXCHEQUER_DEFAULT_CHAIN=ethereum

# How far back a BSC trace looks. NodeReal caps one query at 100,000 blocks
# (~3.5 days), so this is walked in windows: 500,000 blocks is roughly 17 days.
NODEREAL_LOOKBACK_BLOCKS=500000

# Traversal safety limits
TRACE_MAX_DEPTH=4
TRACE_MAX_TXS_PER_ADDRESS=200
TRACE_MAX_NODES=400

# SQLite file (relative paths are resolved against backend/)
EXCHEQUER_DB_PATH=exchequer.db

# --- Free-tier tuning -------------------------------------------------------
# Minimum spacing between Etherscan requests, in seconds. Etherscan documents
# ~5 req/s on the free tier; measured against a live free key, 0.34s spacing was
# refused 54% of the time and every refusal costs a backoff. 0.50s was the
# measured optimum. Raise it if the key is shared with another tool; lower it
# only on a paid plan.
ETHERSCAN_MIN_INTERVAL=0.5

# How long a provider response stays reusable, in seconds. On-chain history is
# append-only, so a cached answer can lag the newest blocks but never contradict
# them. This is what makes a repeat trace, or the reverse of one already run,
# cost no API calls at all.
API_CACHE_TTL_SECONDS=600
